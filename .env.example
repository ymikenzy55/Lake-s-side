# ── Database (Neon / PostgreSQL) ──
# DATABASE_URL uses the pooled connection; DIRECT_DATABASE_URL the non-pooled one (used by migrations).
DATABASE_URL="postgresql://user:password@host-pooler:5432/db?sslmode=require"
DIRECT_DATABASE_URL="postgresql://user:password@host:5432/db?sslmode=require"

# ── App ──
NEXT_PUBLIC_APP_URL="http://localhost:3100"

# ── Security ──
# 32+ random chars. Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# ── First super-admin (used by `npm run db:seed`; never hard-coded) ──
ADMIN_EMAIL="admin@your-domain.com"
ADMIN_PASSWORD="choose-a-long-unique-password"

# ── Payments (Paystack) - leave blank to run cash-on-delivery only ──
PAYSTACK_SECRET_KEY=""
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""

# ── Email: use EITHER SMTP (e.g. Gmail app password) OR Brevo ──
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Comfort_fit GH <you@gmail.com>"

# ── Email (Brevo) - leave blank in development; links are logged to the console instead ──
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="noreply@your-domain.com"
BREVO_SENDER_NAME="Comfort_fit GH"

# ── Image storage - Cloudinary on serverless hosts; blank = local public/uploads ──
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Analytics (optional) ──
NEXT_PUBLIC_META_PIXEL_ID=""
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# ── Operations ──
# Secret for /api/cron/maintenance (16+ chars). Set TRUST_PROXY=true only behind a trusted reverse proxy.
CRON_SECRET=""
TRUST_PROXY="false"

# Optional: lets the admin "Generate description" button use Claude. Without it a built-in writer is used.
ANTHROPIC_API_KEY=""
